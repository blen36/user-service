# Copy to .env and set a password for the NEW Docker database.
# Keep .env out of Git. It is read by Docker Compose, not by IntelliJ.
POSTGRES_DB=user_service_db
POSTGRES_USER=user_service
POSTGRES_PASSWORD=
SERVER_PORT=8081
AUTH_REGISTRATION_KEY=
AUTH_JWKS_URI=http://auth-service:8082/.well-known/jwks.json